# ==============================================================================
# Google Photos Discovery Engine — Master Environment Variable Template
# Placeholders only. No secrets.
# Governed by: part1_discovery_engine_implementation_spec.md
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Railway / Localhost:8000)
# ------------------------------------------------------------------------------
PYTHONUNBUFFERED=1
PORT=8000
APP_ENV=development

# Database Configuration (Supabase PostgreSQL 15+ with pgvector) — Scheduled for Step 2
DATABASE_URL=postgresql://postgres:PLACEHOLDER_PASSWORD@db.PLACEHOLDER_REF.supabase.co:5432/postgres

# Google Gemini API Key (Server-Side Only on Railway) — Scheduled for Step 7
GEMINI_API_KEY=PLACEHOLDER_GEMINI_API_KEY

# Groq NLU API Key & Model (Server-Side Only — Memory Search MVP)
GROQ_API_KEY=PLACEHOLDER_GROQ_API_KEY
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Local Embedding Model (Railway CPU Container) — Scheduled for Step 5
# Selection is deferred to Step 5 (Deployment Benchmark). Leave empty during Step 1 foundation.
EMBEDDING_MODEL_NAME=

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Frontend Configuration (Vercel / Localhost:3000)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
