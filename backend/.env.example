# ==============================================================================
# Backend Environment Configuration Template
# All secrets and external endpoints use placeholders only.
# DO NOT COMMIT REAL CREDENTIALS.
# ==============================================================================

# Server Configuration
PYTHONUNBUFFERED=1
PORT=8000
APP_ENV=development

# Database Configuration (Supabase PostgreSQL with pgvector) — Step 2
# Placeholder format: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:PLACEHOLDER_PASSWORD@db.PLACEHOLDER_REF.supabase.co:5432/postgres

# Google Gemini API Key (Server-Side Only — Railway) — Step 7
GEMINI_API_KEY=PLACEHOLDER_GEMINI_API_KEY

# Retrieval Mode Configuration — Section 24 Lexical FTS Fallback
# Active fallback following Step 5 benchmark NO_ELIGIBLE_CANDIDATE determination
RETRIEVAL_MODE=lexical_fts

# Embedding Model Configuration (Railway CPU Container)
# Bypassed/empty under Section 24 Lexical FTS Fallback to preserve container memory
EMBEDDING_MODEL_NAME=

# CORS Allowed Origins (Comma-separated)
# Development: CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production (Railway): Set to your Vercel deployment URL, e.g.:
# CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

