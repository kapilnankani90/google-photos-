# ==============================================================================
# Frontend Environment Configuration Template
# Target: Vercel (Production) / Localhost (Development)
# ==============================================================================

# Backend API Base URL (FastAPI instance on Railway or Localhost)
# Development: http://localhost:8000
# Production (Vercel): Set to your Railway backend URL, e.g.:
# NEXT_PUBLIC_API_BASE_URL=https://your-backend.up.railway.app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Application Environment (development | production)
NEXT_PUBLIC_APP_ENV=development
